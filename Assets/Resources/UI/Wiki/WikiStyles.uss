/* Wiki / Ajuda — modal estilo HTML+CSS, servido via UI Toolkit.
   Placeholder visual: simples, mas limpo. Ajustar depois junto com o conteúdo real. */

/* Mesma correção de fonte que a Loja (StoreStyles.uss): força TTF embutido no projeto.
   Sem isto, Label/Button podem ficar invisíveis em runtime com o tema padrão do painel. */
Label, Button {
    -unity-font-definition: initial;
    -unity-font: url('/Assets/TextMesh Pro/Fonts/LiberationSans.ttf');
}

/* Raiz do documento — como a Store: flex no painel. O overlay .wiki-overlay
   é position:absolute (fora do fluxo), por isso precisamos de .wiki-root-fill
   em fluxo para o pai ter altura > 0. */
.wiki-root {
    flex-direction: column;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-height: 0;
    position: relative;
}

/* Ocupa o espaço do painel em fluxo; transparente; cliques ignorados. */
.wiki-root-fill {
    flex-grow: 1;
    flex-shrink: 0;
    width: 100%;
    min-height: 0;
}

/* Overlay ocupa tudo e escurece o fundo. display: flex quando aberto. */
.wiki-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.72);
    align-items: center;
    justify-content: center;
}

/* A "janela" da wiki: limita altura para o corpo rolar dentro da área útil da tela */
.wiki-modal {
    width: 96%;
    max-width: 920px;
    height: 88%;
    max-height: 640px;
    min-height: 360px;
    background-color: rgb(22, 24, 34);
    border-width: 2px;
    border-color: rgb(90, 108, 168);
    border-radius: 12px;
    flex-direction: column;
    align-items: stretch;
    overflow: hidden;
    flex-shrink: 1;
    position: relative;
}

.wiki-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    flex-grow: 0;
    min-height: 54px;
    padding: 16px 22px;
    background-color: rgb(30, 34, 50);
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 70, 100);
}

.wiki-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(230, 235, 250);
}

.wiki-close-btn {
    width: 34px;
    height: 34px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
    background-color: rgba(200, 60, 70, 0.85);
    border-width: 0;
    border-radius: 6px;
    padding: 0;
    -unity-text-align: middle-center;
}

.wiki-close-btn:hover {
    background-color: rgb(230, 75, 85);
}

/* Corpo: flex-basis 0 + min-height 0 evita o painel “invadir” a topbar (overflow no topo). */
.wiki-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
}

/* ----- Coluna de abas à esquerda (coluna + ScrollView interno) ----- */
.wiki-tabs {
    width: 208px;
    min-width: 208px;
    min-height: 0;
    background-color: rgb(18, 20, 28);
    padding: 12px 8px 14px 8px;
    border-right-width: 1px;
    border-right-color: rgb(60, 70, 100);
    flex-direction: column;
    flex-shrink: 0;
    overflow: hidden;
}

.wiki-tabs-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
}

.wiki-tabs-section-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(130, 142, 175);
    margin-top: 14px;
    margin-bottom: 4px;
    margin-left: 6px;
    margin-right: 4px;
    letter-spacing: 0.4px;
    -unity-text-align: upper-left;
}

.wiki-tabs-section-title--first {
    margin-top: 4px;
}

.wiki-tabs-separator {
    height: 1px;
    margin-top: 12px;
    margin-bottom: 4px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgba(100, 120, 180, 0.5);
}

.wiki-tab {
    min-height: 42px;
    margin: 8px 0;
    padding: 10px 14px;
    -unity-text-align: middle-left;
    font-size: 13px;
    color: rgb(195, 200, 220);
    background-color: transparent;
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
    white-space: normal;
}

.wiki-tab:hover {
    background-color: rgba(80, 100, 160, 0.22);
    color: rgb(235, 240, 255);
}

.wiki-tab--active {
    background-color: rgba(80, 120, 200, 0.28);
    color: rgb(255, 255, 255);
    border-left-color: rgb(120, 170, 255);
    -unity-font-style: bold;
}

/* ----- Área de conteúdo à direita: wrap + scroll ocupam o espaço vertical restante ----- */
.wiki-content-wrap {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background-color: rgb(26, 28, 40);
}

.wiki-content-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    width: 100%;
}

/* Um único filho no ScrollView: evita empilhamento estranho de várias páginas no layout. */
.wiki-content-pages {
    flex-direction: column;
    align-items: stretch;
    width: 100%;
}

/* Conteúdo rolável: respiro consistente (topo nunca cola no header — scroll fica só no corpo). */
.wiki-page {
    padding: 20px 28px 36px 28px;
}

.wiki-page-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(235, 240, 255);
    margin-top: 0;
    margin-bottom: 18px;
    padding-top: 4px;
    padding-bottom: 2px;
    letter-spacing: 0.2px;
    flex-shrink: 0;
}

.wiki-page-body {
    font-size: 15px;
    color: rgb(200, 210, 230);
    white-space: normal;
    -unity-text-align: upper-left;
    margin-top: 0;
    margin-bottom: 14px;
    padding-top: 0;
    padding-bottom: 2px;
    flex-shrink: 0;
}

/* Figuras do tutorial (mesma ordem que o .docx: após o parágrafo que introduz o alinhamento / conta). */
.wiki-theory-figure {
    flex-shrink: 0;
    align-self: center;
    width: 96%;
    max-width: 520px;
    height: 240px;
    min-height: 180px;
    margin-top: 14px;
    margin-bottom: 22px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(100, 130, 200, 0.4);
    background-color: rgba(14, 16, 26, 0.55);
    -unity-background-scale-mode: scale-to-fit;
}

.wiki-theory-figure--add-decimal {
    background-image: url("/Assets/Images/Wiki/add_decimal_ex.png");
}

.wiki-theory-figure--multi-decimal {
    background-image: url("/Assets/Images/Wiki/multi_decimal_ex.png");
}

.wiki-theory-figure--div-decimal {
    background-image: url("/Assets/Images/Wiki/div_decimal_example.png");
}

.wiki-math-example {
    flex-shrink: 0;
    margin-top: 8px;
    margin-bottom: 18px;
    margin-left: 2px;
    padding: 14px 18px;
    border-radius: 6px;
    border-left-width: 3px;
    border-left-color: rgba(100, 140, 220, 0.55);
    background-color: rgba(0, 0, 0, 0.22);
}

.wiki-math-example-line {
    font-size: 15px;
    color: rgb(215, 222, 245);
    margin-top: 0;
    margin-bottom: 6px;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: upper-left;
    flex-shrink: 0;
}

/* Tópicos: separador acima (USS do Unity não suporta seletor adjacente +; use --first no UXML) */
.wiki-section-title {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(218, 226, 255);
    white-space: normal;
    -unity-text-align: upper-left;
    margin-top: 22px;
    margin-bottom: 12px;
    padding-top: 14px;
    padding-bottom: 2px;
    border-top-width: 1px;
    border-top-color: rgba(100, 120, 180, 0.38);
    flex-shrink: 0;
}

/* Primeiro tópico de cada página: sem linha; respiro claro após o título da página */
.wiki-section-title--first {
    margin-top: 4px;
    margin-bottom: 12px;
    padding-top: 0;
    padding-bottom: 2px;
    border-top-width: 0;
}

/* Primeiro tópico logo após só o título (sem parágrafo antes) */
.wiki-section-title--first.wiki-section-title--after-title-only {
    margin-top: 10px;
    margin-bottom: 12px;
}

/* ----- Tabela (ex.: página Dificuldade) ----- */
.wiki-table {
    flex-direction: column;
    margin-top: 8px;
    margin-bottom: 22px;
    border-width: 1px;
    border-color: rgba(100, 120, 180, 0.55);
    border-radius: 8px;
    overflow: hidden;
    background-color: rgba(14, 16, 24, 0.65);
}

.wiki-table-row {
    flex-direction: row;
    align-items: stretch;
    min-height: 40px;
}

.wiki-table-row--header {
    background-color: rgb(36, 40, 58);
}

/* Zebrado: não usar :nth-child(even) — Unity pode logar "Recursive pseudo classes are not supported". */
.wiki-table-row--striped {
    background-color: rgba(255, 255, 255, 0.04);
}

.wiki-table-cell {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    padding: 10px 10px;
    font-size: 13px;
    color: rgb(200, 210, 230);
    white-space: normal;
    -unity-text-align: middle-center;
    border-right-width: 1px;
    border-right-color: rgba(100, 120, 180, 0.28);
    border-bottom-width: 1px;
    border-bottom-color: rgba(100, 120, 180, 0.28);
}

/* Última linha / última coluna: classes no UXML em vez de :last-child. */
.wiki-table-row--last .wiki-table-cell {
    border-bottom-width: 0;
}

.wiki-table-cell--last {
    border-right-width: 0;
}

.wiki-table-row--header .wiki-table-cell {
    -unity-font-style: bold;
    color: rgb(228, 232, 250);
    font-size: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.wiki-table-cell--dificuldade {
    flex-grow: 0;
    flex-basis: 22%;
    flex-shrink: 0;
    min-width: 72px;
    -unity-text-align: middle-left;
    padding-left: 14px;
}

.wiki-table-row--data .wiki-table-cell--dificuldade {
    -unity-font-style: bold;
    color: rgb(215, 222, 248);
}

/* ----- Botão de abrir a wiki (ancorado no mapa) ----- */
.wiki-open-btn {
    position: absolute;
    top: 20px;
    right: 240px; /* deixa espaço para o botão TEMP da loja no canto */
    width: 180px;
    height: 44px;
    background-color: rgb(44, 52, 80);
    color: rgb(230, 235, 250);
    font-size: 16px;
    -unity-font-style: bold;
    border-width: 2px;
    border-color: rgb(90, 110, 160);
    border-radius: 8px;
}

.wiki-open-btn:hover {
    background-color: rgb(60, 75, 115);
    border-color: rgb(130, 160, 220);
    color: rgb(255, 255, 255);
}

/* ----- Rodapé do modo "revisão de teoria" (abertura automática no duelo) ----- */
.wiki-revision-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    padding: 14px 22px 18px 22px;
    background-color: rgb(30, 34, 50);
    border-top-width: 1px;
    border-top-color: rgb(60, 70, 100);
}

.wiki-revision-toggle {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    min-width: 0;
    color: rgb(210, 220, 240);
    font-size: 13px;
    margin-right: 18px;
}

/* Caixa do checkbox — reconstruída à mão porque o sprite do Toggle é um
   recurso de Editor e fica invisível em runtime com este tema. */
.wiki-revision-toggle > .unity-toggle__input {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    margin-right: 10px;
    background-color: rgb(40, 44, 62);
    border-width: 2px;
    border-color: rgb(120, 140, 200);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
}

.wiki-revision-toggle:hover > .unity-toggle__input {
    border-color: rgb(160, 180, 230);
}

.wiki-revision-toggle > .unity-toggle__input > .unity-toggle__checkmark {
    width: 14px;
    height: 14px;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 2px;
}

.wiki-revision-toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: rgb(120, 180, 255);
}

.wiki-revision-toggle > .unity-toggle__label,
.wiki-revision-toggle > Label {
    color: rgb(210, 220, 240);
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    -unity-text-align: middle-left;
    margin-left: 0;
}

.wiki-revision-proceed-btn {
    min-width: 180px;
    height: 48px;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(248, 250, 255);
    background-color: rgb(72, 96, 168);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(120, 140, 200);
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.wiki-revision-proceed-btn:hover {
    background-color: rgb(90, 118, 196);
    border-color: rgb(150, 170, 230);
}
