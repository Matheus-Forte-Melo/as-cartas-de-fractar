:root {
    flex-grow: 1;
}

Label, Button {
    -unity-font-definition: initial;
    -unity-font: url('/Assets/TextMesh Pro/Fonts/LiberationSans.ttf');
}

.store-container {
    flex-grow: 1;
    background-color: rgb(10, 10, 15); /* Very dark fallback */
    background-image: url('/Assets/Art/Store/MagicDungeonBackground.png');
    -unity-background-image-tint-color: rgb(100, 100, 120); /* Dark, bluish tint to reduce contrast and make items pop */
    -unity-background-scale-mode: scale-and-crop; /* Fixes stretching */
    padding: 40px;
    align-items: center;
}

.store-header {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 30px;
}

.store-title-container {
    flex-direction: row;
    align-items: center;
}

.wave-char {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    padding: 0;
    margin: 0;
}

.back-button {
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    background-color: #FFA12B;
    padding: 12px 24px;
    
    border-radius: 0;
    
    border-top-width: 4px;
    border-top-color: #FFE5C4;
    border-left-width: 4px;
    border-left-color: #FFC073;
    border-right-width: 4px;
    border-right-color: #D67C1F;
    border-bottom-width: 10px;
    border-bottom-color: #915100;
    
    margin-bottom: 0;
    
    transition-duration: 0s;
}

.back-button:hover {
    background-color: #F78900;
    border-left-color: #FFA12B;
}

.back-button:active {
    background-color: #F78900;
    border-bottom-width: 2px;
    margin-bottom: 8px;
    translate: 0 8px;
}

.header-right {
    flex-direction: row;
    align-items: center;
}

.consumable-slots-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(180, 220, 255);
    margin-top: 6px;
    margin-right: 20px;
}

.player-balance {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 215, 0);
}

.coin-icon {
    width: 20px;
    height: 20px;
    margin-left: 8px;
    border-radius: 10px;
    background-color: rgb(255, 215, 0);
    border-width: 2px;
    border-color: rgb(218, 165, 32);
}

.items-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
    max-width: 1200px;
}

/* Store Item Styles */
.store-item {
    width: 220px;
    height: 300px;
    background-color: rgba(30, 35, 50, 0.9);
    border-radius: 12px;
    margin: 15px;
    padding: 15px;
    align-items: center;
    justify-content: space-between;
    border-width: 2px;
    border-color: rgba(80, 90, 130, 0.8);
}

.store-item:hover {
    border-color: rgb(120, 160, 255);
    background-color: rgba(40, 45, 65, 0.95);
}

.item-icon {
    width: 120px;
    height: 120px;
    margin-top: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.item-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: white;
    margin-top: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
    height: 40px; /* Force 2 lines of predictable height for alignment */
    width: 100%;
}

.item-price-container {
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
}

.item-price {
    font-size: 18px;
    color: rgb(255, 200, 50);
    -unity-font-style: bold;
}

/* Neon Glowing Button */
.buy-btn-container {
    width: 150px;
    height: 50px;
    margin-top: 15px;
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

.buy-btn-shadow {
    position: absolute;
    left: 0; right: 0; top: 8px; bottom: -8px;
    background-color: #371b5b;
    border-radius: 8px;
}

.buy-btn-container:hover .buy-btn-shadow {
    background-color: #763ac2;
}

.buy-btn-top {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: #5f309b;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
}

.buy-btn-container:hover .buy-btn-top {
    background-color: #a661ff;
}

.buy-btn-label {
    color: rgb(200, 180, 230);
    font-size: 18px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.buy-btn-container:hover .buy-btn-label {
    color: white;
}

.buy-btn-glow {
    position: absolute;
    left: -10px; right: -10px; top: -10px; bottom: -10px;
    border-radius: 12px;
    background-color: rgba(166, 97, 255, 0.0);
}

.buy-btn-container:hover .buy-btn-glow {
    background-color: rgba(166, 97, 255, 0.1);
}

/* Active / Pressed State */
.buy-btn-container:active .buy-btn-top {
    translate: 0 6px;
    background-color: #c79cff;
}
.buy-btn-container:active .buy-btn-shadow {
    top: 14px; bottom: -2px;
}
.buy-btn-container:active .buy-btn-label {
    color: white;
}

/* Purchased State */
.buy-btn-container.purchased .buy-btn-shadow {
    background-color: rgb(30, 30, 30);
}
.buy-btn-container.purchased .buy-btn-top {
    background-color: rgb(50, 50, 50);
    translate: 0 6px;
}
.buy-btn-container.purchased .buy-btn-label {
    color: rgb(150, 150, 150);
    text-shadow: none;
}
.buy-btn-container.purchased .buy-btn-glow {
    background-color: transparent;
}
.buy-btn-container.purchased {
}

/* Modal Styles */
.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.8);
    align-items: center;
    justify-content: center;
}

.modal-box {
    background-color: rgb(40, 40, 40);
    padding: 30px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(70, 70, 70);
    width: 400px;
    align-items: center;
}

.modal-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 15px;
}

.modal-message {
    font-size: 18px;
    color: rgb(200, 200, 200);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 25px;
}

.modal-buttons {
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
}

.modal-btn-cancel {
    padding: 10px 20px;
    background-color: rgb(80, 80, 80);
    color: white;
    border-radius: 6px;
    border-width: 0;
    font-size: 16px;
}

.modal-btn-cancel:hover {
    background-color: rgb(100, 100, 100);
}

.modal-btn-confirm {
    padding: 10px 20px;
    background-color: rgb(40, 160, 60);
    color: white;
    border-radius: 6px;
    border-width: 0;
    font-size: 16px;
    -unity-font-style: bold;
}

.modal-btn-confirm:hover {
    background-color: rgb(50, 190, 75);
}

.modal-message.error {
    color: rgb(255, 80, 80);
}

/* Info / Flip Button */
.info-btn {
    position: absolute;
    top: 5px;
    right: 5px;
    width: 25px;
    height: 25px;
    background-color: transparent;
    border-width: 2px;
    border-color: rgba(200, 200, 200, 0.5);
    border-radius: 4px;
    color: rgb(200, 200, 200);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.info-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: white;
    border-color: white;
}

/* Item Front/Back Containers */
.item-front {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: space-between;
}

.item-back {
    width: 100%;
    height: 100%;
    display: none;
    align-items: center;
    justify-content: center;
}

.item-desc {
    color: rgb(200, 210, 230);
    font-size: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
    width: 100%;
    height: 100%;
}

/* Flipped State */
.store-item.flipped .item-front {
    display: none;
}

.store-item.flipped .item-back {
    display: flex;
}