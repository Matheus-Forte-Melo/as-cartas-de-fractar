<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd">

    <ui:Style src="WikiStyles.uss" />

    <ui:VisualElement name="WikiRoot" class="wiki-root" picking-mode="Ignore">

        <!-- Filho em fluxo (não absolute): o overlay é position:absolute e não dá altura ao pai.
             Sem isto o WikiRoot colapsa a ~0px e o modal fica fora da área visível. -->
        <ui:VisualElement name="WikiRootFill" class="wiki-root-fill" picking-mode="Ignore" />

        <ui:VisualElement name="WikiOverlay" class="wiki-overlay" style="display: none;">

            <ui:VisualElement class="wiki-modal">

                <ui:VisualElement class="wiki-header">
                    <ui:Label name="WikiTitle" text="Ajuda / Wiki" class="wiki-title" />
                    <ui:Button name="WikiCloseBtn" text="X" class="wiki-close-btn" />
                </ui:VisualElement>

                <ui:VisualElement class="wiki-body">

                    <ui:VisualElement name="WikiTabs" class="wiki-tabs">
                        <ui:ScrollView class="wiki-tabs-scroll" style="width: 100%; flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0;">
                            <ui:Label text="Teoria" class="wiki-tabs-section-title wiki-tabs-section-title--first" />
                            <!-- TheoryWikiPage.Addition → WikiTab_math_add -->
                            <ui:Button name="WikiTab_math_add" text="Adição" class="wiki-tab" />
                            <!-- TheoryWikiPage.Subtraction → WikiTab_math_sub -->
                            <ui:Button name="WikiTab_math_sub" text="Subtração" class="wiki-tab" />
                            <!-- TheoryWikiPage.Multiplication → WikiTab_math_mul -->
                            <ui:Button name="WikiTab_math_mul" text="Multiplicação" class="wiki-tab" />
                            <!-- TheoryWikiPage.Division → WikiTab_math_div -->
                            <ui:Button name="WikiTab_math_div" text="Divisão" class="wiki-tab" />
                            <ui:VisualElement class="wiki-tabs-separator" />
                            <ui:Label text="Gameplay" class="wiki-tabs-section-title" />
                            <ui:Button name="WikiTab_overview" text="Visão geral" class="wiki-tab wiki-tab--active" />
                            <ui:Button name="WikiTab_map" text="Mapa" class="wiki-tab" />
                            <ui:Button name="WikiTab_combat" text="Combate" class="wiki-tab" />
                            <ui:Button name="WikiTab_difficulty" text="Dificuldade" class="wiki-tab" />
                            <ui:Button name="WikiTab_enemies" text="Operações" class="wiki-tab" />
                            <ui:Button name="WikiTab_economy" text="Economia" class="wiki-tab" />
                            <ui:Button name="WikiTab_controls" text="Controles" class="wiki-tab" />
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <ui:VisualElement class="wiki-content-wrap">
                        <ui:ScrollView class="wiki-content-scroll" style="width: 100%; flex-grow: 1; flex-shrink: 1; min-height: 0;">

                            <ui:VisualElement class="wiki-content-pages">
                            <ui:VisualElement name="WikiPage_overview" class="wiki-page">
                                <ui:Label class="wiki-page-title" text="Visão geral" />
                                <ui:Label class="wiki-page-body" text="Você enfrenta duelos de blackjack em que cada carta vale uma equação. Sobe o mapa escolhendo duelos ligados uns aos outros, entra em combates e tenta levar a vida do oponente a zero antes da sua." />
                                <ui:Label class="wiki-section-title wiki-section-title--first" text="Moedas e loja" />
                                <ui:Label class="wiki-page-body" text="O saldo de moedas persiste entre tentativas. Para saber como ganhar moedas, abrir a loja, equipar ataque e defesa e usar consumíveis, abra a aba Economia." />
                                <ui:Label class="wiki-section-title" text="Se perder a run" />
                                <ui:Label class="wiki-page-body" text="Você volta ao começo do mapa com um novo traçado de caminhos, escolhe de novo a partir da primeira fileira e sua vida sobe até o máximo que seus equipamentos de defesa permitem. O saldo de moedas não é zerado." />
                                <ui:Label class="wiki-section-title" text="Se vencer um duelo" />
                                <ui:Label class="wiki-page-body" text="Sua vida e seu saldo são atualizados, você recebe moedas extras conforme a dificuldade daquele duelo, e retorna ao mapa no mesmo lugar em que estava." />
                            </ui:VisualElement>

                            <ui:VisualElement name="WikiPage_map" class="wiki-page" style="display: none;">
                                <ui:Label class="wiki-page-title" text="Mapa" />
                                <ui:Label class="wiki-page-body" text="Cada ponto do mapa é um duelo com tema de adição, subtração, multiplicação ou divisão. A dificuldade das equações daquele ponto sobe conforme você avança em profundidade no desenho do mapa." />
                                <ui:Label class="wiki-section-title wiki-section-title--first" text="Primeira escolha" />
                                <ui:Label class="wiki-page-body" text="Depois de uma derrota, ou no início de uma nova tentativa, você ainda não está em nenhum duelo: só pode entrar em pontos da primeira fileira. Depois da primeira escolha, só pode seguir para duelos ligados por um caminho a partir de onde você está agora." />
                                <ui:Label class="wiki-section-title" text="Fácil, médio e difícil" />
                                <ui:Label class="wiki-page-body" text="O jogo divide a altura do mapa em três faixas. Quanto mais alto você sobe na torre desenhada, mais comum ficam duelos médios e difíceis. Na prática, quem está embaixo vê mais combates leves; quem chega no topo encara equações e inimigos mais pesados." />
                                <ui:Label class="wiki-section-title" text="Clique e câmera" />
                                <ui:Label class="wiki-page-body" text="Um toque conta como clique só se você soltar o dedo perto de onde apertou. Se estiver arrastando a visão ou girando a roda para mover a câmera, isso não escolhe duelo. Se o cursor estiver em cima de um menu ou botão (por exemplo Ajuda), o clique fica com esse elemento e não com o mapa." />
                                <ui:Label class="wiki-section-title" text="O que muda na tela" />
                                <ui:Label class="wiki-page-body" text="Duelos que você não pode visitar ficam apagados. Onde você está pode ganhar destaque. A câmera só se move na vertical: arrastar ou rolar reposiciona a vista." />
                            </ui:VisualElement>

                            <ui:VisualElement name="WikiPage_combat" class="wiki-page" style="display: none;">
                                <ui:Label class="wiki-page-title" text="Combate" />
                                <ui:Label class="wiki-page-body" text="Cada rodada vai até alguém passar de 21, alguém parar e o outro mostrar carta melhor, ou as duas mãos empatarem no mesmo total. O limite usado nas contas de dano é sempre 21." />
                                <ui:Label class="wiki-section-title wiki-section-title--first" text="Dificuldade do duelo: atributos e moedas" />
                                <ui:Label class="wiki-page-body" text="Cada combate no mapa (exceto o boss final) é Fácil, Médio ou Difícil. Isso define a vida máxima do oponente, o multiplicador de dano aplicado a você quando você perde uma rodada, e as moedas somadas ao saldo quando você vence o duelo inteiro. Fractar (boss) usa valores próprios na última linha." />
                                <ui:VisualElement class="wiki-table">
                                    <ui:VisualElement class="wiki-table-row wiki-table-row--header">
                                        <ui:Label text="Dificuldade" class="wiki-table-cell wiki-table-cell--dificuldade" />
                                        <ui:Label text="Vida máx. do oponente" class="wiki-table-cell" />
                                        <ui:Label text="Mult. dano a você (rodada perdida)" class="wiki-table-cell" />
                                        <ui:Label text="Moedas ao vencer o duelo" class="wiki-table-cell wiki-table-cell--last" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wiki-table-row wiki-table-row--data wiki-table-row--striped">
                                        <ui:Label text="Fácil" class="wiki-table-cell wiki-table-cell--dificuldade" />
                                        <ui:Label text="80" class="wiki-table-cell" />
                                        <ui:Label text="1,0" class="wiki-table-cell" />
                                        <ui:Label text="100" class="wiki-table-cell wiki-table-cell--last" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wiki-table-row wiki-table-row--data">
                                        <ui:Label text="Médio" class="wiki-table-cell wiki-table-cell--dificuldade" />
                                        <ui:Label text="150" class="wiki-table-cell" />
                                        <ui:Label text="1,5" class="wiki-table-cell" />
                                        <ui:Label text="250" class="wiki-table-cell wiki-table-cell--last" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wiki-table-row wiki-table-row--data wiki-table-row--striped">
                                        <ui:Label text="Difícil" class="wiki-table-cell wiki-table-cell--dificuldade" />
                                        <ui:Label text="300" class="wiki-table-cell" />
                                        <ui:Label text="1,75" class="wiki-table-cell" />
                                        <ui:Label text="500" class="wiki-table-cell wiki-table-cell--last" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wiki-table-row wiki-table-row--data wiki-table-row--last">
                                        <ui:Label text="Boss (Fractar)" class="wiki-table-cell wiki-table-cell--dificuldade" />
                                        <ui:Label text="600" class="wiki-table-cell" />
                                        <ui:Label text="2,0" class="wiki-table-cell" />
                                        <ui:Label text="500" class="wiki-table-cell wiki-table-cell--last" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:Label class="wiki-page-body" text="Números iguais ao código: vida e multiplicador de dano ao jogador — EnemyCombatBalance.GetEnemyMaxHealth / GetEnemyDamageMultiplier; moedas — BattleRewardResolver.GetCoinReward; boss — BossFightBalance.MaxHealth e DamageMultiplier." />
                                <ui:Label class="wiki-page-body" text="O multiplicador da terceira coluna multiplica o dano base quando você perde a rodada (|sua mão − 21|, mínimo 1, × 10, arredondado — RoundDamageResolver)." />
                                <ui:Label class="wiki-page-body" text="Esse multiplicador pesa mais no Médio e no Difícil do que no Fácil. Vencer Fractar concede 500 moedas (Hard em GetCoinReward), conclui a run e envia ao menu principal." />
                                <ui:Label class="wiki-section-title" text="Dano ao fim da rodada" />
                                <ui:Label class="wiki-page-body" text="Quem perde a rodada perde vida. O jogo mede quanto a mão do perdedor ficou longe de 21. Essa distância nunca conta como zero na hora do golpe: no mínimo vale 1. Multiplica por dez e arredonda: esse é o dano base." />
                                <ui:Label class="wiki-page-body" text="Se quem apanhou foi o inimigo, o dano é ampliado pelos seus equipamentos de ataque (bónus cumulativos ao multiplicador — ver aba Economia). Se quem apanhou foi você, o dano ainda é multiplicado conforme a linha da tabela acima para aquele duelo." />
                                <ui:Label class="wiki-section-title" text="Empate" />
                                <ui:Label class="wiki-page-body" text="Mesmo número nas duas mãos: ninguém perde vida naquela rodada." />
                                <ui:Label class="wiki-section-title" text="Oponente" />
                                <ui:Label class="wiki-page-body" text="Ele compra carta enquanto a mão dele estiver abaixo de 17 e ainda puder jogar sem estourar o limite da mesa. Quando ele parar, a vez volta para você se a rodada continuar." />
                                <ui:Label class="wiki-section-title" text="Cartas no duelo" />
                                <ui:Label class="wiki-page-body" text="O baralho que você enfrenta combina o tema do duelo (adição, subtração, multiplicação ou divisão) com o quão difícil é o ponto. Mesmo tema em duelo mais difícil traz contas mais exigentes." />
                            </ui:VisualElement>

                            <ui:VisualElement name="WikiPage_difficulty" class="wiki-page" style="display: none;">
                                <ui:Label class="wiki-page-title" text="Dificuldade no mapa" />
                                <ui:Label class="wiki-page-body" text="Cada duelo no mapa é classificado como fácil, médio ou difícil. Isso influencia a vida do oponente, o peso do dano quando você perde uma rodada e as moedas ganhas se vencer o duelo — todos os números estão na tabela da aba Combate." />
                                <ui:Label class="wiki-section-title wiki-section-title--first" text="Faixas da torre" />
                                <ui:Label class="wiki-page-body" text="O jogo divide a altura do mapa em faixas. Quanto mais alto você sobe, mais comuns ficam duelos médios e difíceis; em baixo predominam combates mais leves nas equações e nos atributos do oponente." />
                                <ui:Label class="wiki-section-title" text="Confronto final — Fractar" />
                                <ui:Label class="wiki-page-body" text="No topo há um único nó de boss. Fractar: 600 de vida, multiplicador 2,0 sobre o dano que você recebe ao perder uma rodada, 500 moedas na vitória (linha do boss na aba Combate ou Economia). Vencer conclui a run e regressa ao menu principal." />
                                <ui:Label class="wiki-section-title" text="Moedas e loja" />
                                <ui:Label class="wiki-page-body" text="Como gastar moedas, equipar itens e gerir consumíveis está na aba Economia." />
                            </ui:VisualElement>

                                                        <!-- TheoryWikiPage.Addition -->
                            <ui:VisualElement name="WikiPage_math_add" class="wiki-page" style="display: none;">
                            <ui:Label class="wiki-page-title" text="Adição" />
                            <ui:Label class="wiki-section-title wiki-section-title--first" text="Contas de adição" />
                            <ui:Label class="wiki-page-body" text="Na adição, você deve juntar os valores." />
                            <ui:Label class="wiki-section-title" text="Exemplo: 2 + 3" />
                            <ui:Label class="wiki-page-body" text="Pegue o primeiro número: 2." />
                            <ui:Label class="wiki-page-body" text="Some com o segundo número: 3." />
                            <ui:Label class="wiki-page-body" text="O resultado é 5." />
                            <ui:Label class="wiki-page-body" text="A adição serve para aumentar o valor. Sempre que aparecer o sinal +, você deve somar." />
                            <ui:Label class="wiki-section-title" text="Contas de adição com vírgula" />
                            <ui:Label class="wiki-page-body" text="Essas contas funcionam como a adição normal, mas com números decimais." />
                            <ui:Label class="wiki-section-title" text="Exemplo: 1,5 + 2,5" />
                            <ui:Label class="wiki-page-body" text="Junte os números normalmente." />
                            <ui:Label class="wiki-page-body" text="Some a parte inteira com a parte inteira." />
                            <ui:Label class="wiki-page-body" text="Some a parte da vírgula com a parte da vírgula." />
                            <ui:Label class="wiki-page-body" text="O resultado é 4,0 ou simplesmente 4." />
                            <ui:Label class="wiki-page-body" text="A vírgula mostra que o número não é inteiro. Mesmo assim, a regra continua a mesma: somar os valores." />
                            <ui:Label class="wiki-page-body" text="Sempre deixe vírgula em cima de vírgula para fazer os cálculos:" />
                            <ui:VisualElement name="WikiFigureAddDecimal" class="wiki-theory-figure wiki-theory-figure--add-decimal" picking-mode="Ignore" />
                            <ui:Label class="wiki-page-body" text="Onde não tem número é o mesmo que ter 0 (zero)." />
                            <ui:Label class="wiki-section-title" text="Nas cartas" />
                            <ui:Label class="wiki-page-body" text="Em duelos de adição, uma carta pode aparecer como várias parcelas que somam ao valor da carta." />
                            </ui:VisualElement>

                            <!-- TheoryWikiPage.Subtraction -->
                            <ui:VisualElement name="WikiPage_math_sub" class="wiki-page" style="display: none;">
                            <ui:Label class="wiki-page-title" text="Subtração" />
                            <ui:Label class="wiki-section-title wiki-section-title--first" text="Contas de subtração" />
                            <ui:Label class="wiki-page-body" text="Na subtração, você deve tirar uma quantidade de outra." />
                            <ui:Label class="wiki-page-body" text="Ela mostra quanto sobra depois de retirar um valor." />
                            <ui:Label class="wiki-section-title" text="Exemplo: 55 − 14" />
                            <ui:Label class="wiki-page-body" text="Passo a passo:" />
                            <ui:Label class="wiki-page-body" text="Coloque os números um embaixo do outro." />
                            <ui:Label class="wiki-page-body" text="Alinhe as casas certas: unidade com unidade, dezena com dezena." />
                            <ui:Label class="wiki-page-body" text="Comece sempre da direita para a esquerda." />
                            <ui:Label class="wiki-page-body" text="Primeiro faça a conta das unidades." />
                            <ui:Label class="wiki-page-body" text="Depois faça a conta das dezenas." />
                            <ui:Label class="wiki-section-title" text="Exemplo montado" />
                            <ui:VisualElement class="wiki-math-example">
                            <ui:Label class="wiki-math-example-line" text="55" />
                            <ui:Label class="wiki-math-example-line" text="- 14" />
                            <ui:Label class="wiki-math-example-line" text="----" />
                            <ui:Label class="wiki-math-example-line" text="41" />
                            </ui:VisualElement>
                            <ui:Label class="wiki-section-title" text="Como pensar" />
                            <ui:Label class="wiki-page-body" text="5 − 4 = 1." />
                            <ui:Label class="wiki-page-body" text="5 − 1 = 4." />
                            <ui:Label class="wiki-page-body" text="Resultado final: 41." />
                            <ui:Label class="wiki-section-title" text="Quando o número de cima é menor" />
                            <ui:Label class="wiki-page-body" text="Às vezes a conta não dá para fazer direto." />
                            <ui:Label class="wiki-section-title" text="Exemplo: 42 − 17" />
                            <ui:Label class="wiki-page-body" text="Passo a passo:" />
                            <ui:Label class="wiki-page-body" text="Veja as unidades: 2 − 7 não dá." />
                            <ui:Label class="wiki-page-body" text="Então você pega 1 dezena emprestada do 4." />
                            <ui:Label class="wiki-page-body" text="O 4 vira 3." />
                            <ui:Label class="wiki-page-body" text="O 2 vira 12." />
                            <ui:Label class="wiki-page-body" text="Agora faça 12 − 7 = 5." />
                            <ui:Label class="wiki-page-body" text="Depois faça 3 − 1 = 2." />
                            <ui:Label class="wiki-section-title" text="Exemplo montado" />
                            <ui:VisualElement class="wiki-math-example">
                            <ui:Label class="wiki-math-example-line" text="42" />
                            <ui:Label class="wiki-math-example-line" text="- 17" />
                            <ui:Label class="wiki-math-example-line" text="----" />
                            <ui:Label class="wiki-math-example-line" text="25" />
                            </ui:VisualElement>
                            <ui:Label class="wiki-page-body" text="Resultado: 25." />
                            <ui:Label class="wiki-section-title" text="Subtração com vírgula" />
                            <ui:Label class="wiki-page-body" text="É a mesma lógica de sempre deixar as vírgulas uma em cima da outra para não errar e fazer a subtração normalmente." />
                            <ui:Label class="wiki-section-title" text="Nas cartas" />
                            <ui:Label class="wiki-page-body" text="Em duelos de subtração, a carta pode aparecer como cadeias com menos que fecham no valor da carta." />
                            </ui:VisualElement>

                            <!-- TheoryWikiPage.Multiplication -->
                            <ui:VisualElement name="WikiPage_math_mul" class="wiki-page" style="display: none;">
                            <ui:Label class="wiki-page-title" text="Multiplicação" />
                            <ui:Label class="wiki-section-title wiki-section-title--first" text="Contas de multiplicação" />
                            <ui:Label class="wiki-page-body" text="Na multiplicação, você deve repetir um número várias vezes." />
                            <ui:Label class="wiki-section-title" text="Exemplo: 3 × 4" />
                            <ui:Label class="wiki-page-body" text="O número 3 será repetido 4 vezes." />
                            <ui:Label class="wiki-page-body" text="Isso fica: 3 + 3 + 3 + 3." />
                            <ui:Label class="wiki-page-body" text="O resultado é 12." />
                            <ui:Label class="wiki-page-body" text="Outra forma de pensar é:" />
                            <ui:Label class="wiki-page-body" text="3 × 4 significa 3 vezes 4 ou 4 vezes 3." />
                            <ui:Label class="wiki-page-body" text="O resultado é o mesmo." />
                            <ui:Label class="wiki-page-body" text="Quando aparecer o sinal ×, você deve multiplicar." />
                            <ui:Label class="wiki-section-title" text="Contas de multiplicação com vírgula" />
                            <ui:Label class="wiki-page-body" text="Na multiplicação com vírgula, você a fará normalmente ignorando a vírgula; apenas no final terá que contar as casas decimais atrás das vírgulas para adicionar no resultado." />
                            <ui:VisualElement name="WikiFigureMultiDecimal" class="wiki-theory-figure wiki-theory-figure--multi-decimal" picking-mode="Ignore" />
                            <ui:Label class="wiki-page-body" text="Pode ser colocado o 0 (zero) no lugar do + caso ajude na visualização." />
                            <ui:Label class="wiki-section-title" text="Nas cartas" />
                            <ui:Label class="wiki-page-body" text="Em duelos de multiplicação, a carta pode aparecer como fatores que multiplicam até o valor da carta." />
                            </ui:VisualElement>

                            <!-- TheoryWikiPage.Division -->
                            <ui:VisualElement name="WikiPage_math_div" class="wiki-page" style="display: none;">
                            <ui:Label class="wiki-page-title" text="Divisão e fração" />
                            <ui:Label class="wiki-section-title wiki-section-title--first" text="Contas de divisão" />
                            <ui:Label class="wiki-page-body" text="Na divisão, você deve separar um valor em partes iguais." />
                            <ui:Label class="wiki-section-title" text="Exemplo: 8 ÷ 2" />
                            <ui:Label class="wiki-page-body" text="Pegue o número 8." />
                            <ui:Label class="wiki-page-body" text="Divida-o em 2 partes iguais." />
                            <ui:Label class="wiki-page-body" text="Cada parte fica com 4." />
                            <ui:Label class="wiki-page-body" text="Então, 8 ÷ 2 = 4." />
                            <ui:Label class="wiki-page-body" text="Quando aparecer o sinal ÷ ou /, você deve dividir." />
                            <ui:Label class="wiki-section-title" text="Frações" />
                            <ui:Label class="wiki-page-body" text="Frações representam uma parte de um todo e, na prática, também podem ser entendidas como uma forma de divisão." />
                            <ui:Label class="wiki-page-body" text="Uma fração é escrita com um número em cima e outro embaixo, separados por uma linha." />
                            <ui:Label class="wiki-section-title" text="Exemplo: 3/4" />
                            <ui:Label class="wiki-page-body" text="Para ler uma fração, você lê primeiro o número de cima e depois o de baixo:" />
                            <ui:Label class="wiki-page-body" text="3/4 = três quartos." />
                            <ui:Label class="wiki-page-body" text="1/2 = um meio." />
                            <ui:Label class="wiki-page-body" text="5/6 = cinco sextos." />
                            <ui:Label class="wiki-section-title" text="Na fração" />
                            <ui:Label class="wiki-page-body" text="O número de cima é chamado de numerador;" />
                            <ui:Label class="wiki-page-body" text="O número de baixo é chamado de denominador." />
                            <ui:Label class="wiki-page-body" text="A ordem para interpretar a fração é sempre esta:" />
                            <ui:Label class="wiki-page-body" text="Veja o número de cima." />
                            <ui:Label class="wiki-page-body" text="Veja o número de baixo." />
                            <ui:Label class="wiki-page-body" text="Entenda que o número de cima está sendo dividido pelo número de baixo." />
                            <ui:Label class="wiki-section-title" text="Exemplo: 6/2" />
                            <ui:Label class="wiki-page-body" text="Isso significa: 6 dividido por 2." />
                            <ui:Label class="wiki-page-body" text="O resultado é 3." />
                            <ui:Label class="wiki-page-body" text="Então, a fração funciona como uma divisão escrita de outra forma." />
                            <ui:Label class="wiki-section-title" text="Contas de divisão com vírgula" />
                            <ui:Label class="wiki-page-body" text="Na divisão com vírgula, você precisa igualar as casas decimais atrás da vírgula, multiplicando por 10 para os dois lados, pois o que você faz em um lado tem que ser feito no outro; assim que eliminar as vírgulas, poderá começar a divisão normalmente." />
                            <ui:VisualElement name="WikiFigureDivDecimal" class="wiki-theory-figure wiki-theory-figure--div-decimal" picking-mode="Ignore" />
                            <ui:Label class="wiki-section-title" text="Nas cartas" />
                            <ui:Label class="wiki-page-body" text="Em duelos de divisão, a carta pode aparecer como divisões ou formas equivalentes que fecham no valor da carta." />
                            </ui:VisualElement>

                            <ui:VisualElement name="WikiPage_enemies" class="wiki-page" style="display: none;">
                                <ui:Label class="wiki-page-title" text="Quatro tipos de duelo" />
                                <ui:Label class="wiki-page-body" text="O mapa oferece quatro sabores de combate. Cada um muda o jeito das cartas na mesa e o conjunto de equações que você pode comprar naquele ponto." />
                                <ui:Label class="wiki-section-title wiki-section-title--first" text="Adição" />
                                <ui:Label class="wiki-page-body" text="Cartas tendem a aparecer como somas de parcelas." />
                                <ui:Label class="wiki-section-title" text="Subtração" />
                                <ui:Label class="wiki-page-body" text="Cartas tendem a aparecer como cadeias com menos." />
                                <ui:Label class="wiki-section-title" text="Multiplicação" />
                                <ui:Label class="wiki-page-body" text="Cartas tendem a aparecer como produtos." />
                                <ui:Label class="wiki-section-title" text="Divisão" />
                                <ui:Label class="wiki-page-body" text="Cartas tendem a aparecer como divisões ou formas parecidas." />
                            </ui:VisualElement>

                            <ui:VisualElement name="WikiPage_economy" class="wiki-page" style="display: none;">
                                <ui:Label class="wiki-page-title" text="Economia" />
                                <ui:Label class="wiki-page-body" text="Moedas são o recurso persistente entre runs: ao perder uma tentativa o mapa reinicia, mas o saldo não é zerado. Ao vencer um duelo, o jogo soma ao saldo exatamente as moedas da linha da dificuldade daquele combate (BattleRewardResolver)." />
                                <ui:Label class="wiki-section-title wiki-section-title--first" text="Dificuldade do duelo: inimigo e moedas" />
                                <ui:Label class="wiki-page-body" text="Para cada nó de combate (não boss), a dificuldade define a vida máxima do oponente, o multiplicador aplicado ao dano que você recebe ao perder uma rodada, e as moedas ganhas ao vencer o duelo inteiro. Mesma tabela que na aba Combate." />
                                <ui:VisualElement class="wiki-table">
                                    <ui:VisualElement class="wiki-table-row wiki-table-row--header">
                                        <ui:Label text="Dificuldade" class="wiki-table-cell wiki-table-cell--dificuldade" />
                                        <ui:Label text="Vida máx. do oponente" class="wiki-table-cell" />
                                        <ui:Label text="Mult. dano a você (rodada perdida)" class="wiki-table-cell" />
                                        <ui:Label text="Moedas ao vencer" class="wiki-table-cell wiki-table-cell--last" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wiki-table-row wiki-table-row--data wiki-table-row--striped">
                                        <ui:Label text="Fácil" class="wiki-table-cell wiki-table-cell--dificuldade" />
                                        <ui:Label text="80" class="wiki-table-cell" />
                                        <ui:Label text="1,0" class="wiki-table-cell" />
                                        <ui:Label text="100" class="wiki-table-cell wiki-table-cell--last" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wiki-table-row wiki-table-row--data">
                                        <ui:Label text="Médio" class="wiki-table-cell wiki-table-cell--dificuldade" />
                                        <ui:Label text="150" class="wiki-table-cell" />
                                        <ui:Label text="1,5" class="wiki-table-cell" />
                                        <ui:Label text="250" class="wiki-table-cell wiki-table-cell--last" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wiki-table-row wiki-table-row--data wiki-table-row--striped">
                                        <ui:Label text="Difícil" class="wiki-table-cell wiki-table-cell--dificuldade" />
                                        <ui:Label text="300" class="wiki-table-cell" />
                                        <ui:Label text="1,75" class="wiki-table-cell" />
                                        <ui:Label text="500" class="wiki-table-cell wiki-table-cell--last" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="wiki-table-row wiki-table-row--data wiki-table-row--last">
                                        <ui:Label text="Boss (Fractar)" class="wiki-table-cell wiki-table-cell--dificuldade" />
                                        <ui:Label text="600" class="wiki-table-cell" />
                                        <ui:Label text="2,0" class="wiki-table-cell" />
                                        <ui:Label text="500" class="wiki-table-cell wiki-table-cell--last" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:Label class="wiki-page-body" text="O multiplicador da terceira coluna aplica-se ao dano base da rodada quando você perde (distância à mão vencedora em relação a 21, mínimo 1, × 10 — RoundDamageResolver)." />
                                <ui:Label class="wiki-page-body" text="Fonte: EnemyCombatBalance (HP e mult. de dano ao jogador), BattleRewardResolver (moedas), BossFightBalance (Fractar). Vitória no boss chama ApplyVictoryRewards(save, Hard), daí 500 moedas." />
                                <ui:Label class="wiki-section-title" text="Loja" />
                                <ui:Label class="wiki-page-body" text="No mapa, use o botão roxo da loja (atalho de desenvolvimento até existir hub definitivo). Na loja você gasta moedas em itens do catálogo e volta ao mapa pelo botão Voltar." />
                                <ui:Label class="wiki-section-title" text="Equipamento de ataque" />
                                <ui:Label class="wiki-page-body" text="Cada item ofensivo comprado soma um bónus ao multiplicador de dano que você aplica ao oponente quando ele perde uma rodada: o total é 1 mais a soma de (multiplicador do item − 1) para todas as cópias na sua posse. Você pode comprar o mesmo item várias vezes; nomes, efeitos e preços vêm do catálogo do jogo." />
                                <ui:Label class="wiki-section-title" text="Equipamento de defesa" />
                                <ui:Label class="wiki-page-body" text="Cada peça defensiva comprada aumenta sua vida máxima pelo valor indicado e cura na hora o mesmo montante na vida atual. Várias compras do mesmo item acumulam." />
                                <ui:Label class="wiki-section-title" text="Consumíveis" />
                                <ui:Label class="wiki-page-body" text="Você tem até três espaços de inventário (pense neles como 1, 2 e 3). Com espaço livre, uma compra na loja coloca o item num slot. No seu turno no duelo, as teclas 1, 2 e 3 usam o consumível daquele slot; a cura respeita a vida máxima atual. Depois de usar, o slot fica vazio." />
                                <ui:Label class="wiki-page-body" text="Com os três espaços cheios, não dá para comprar outro consumível até você usar um na batalha." />
                            </ui:VisualElement>

                            <ui:VisualElement name="WikiPage_controls" class="wiki-page" style="display: none;">
                                <ui:Label class="wiki-page-title" text="Controles" />
                                <ui:Label class="wiki-section-title wiki-section-title--first wiki-section-title--after-title-only" text="Mapa" />
                                <ui:Label class="wiki-page-body" text="Mouse para escolher duelos. Scroll ou arrasto vertical move a câmera. Esc fecha esta ajuda quando ela estiver aberta." />
                                <ui:Label class="wiki-section-title" text="Combate" />
                                <ui:Label class="wiki-page-body" text="Mouse nos botões da mesa. Espaço passa o turno (parar). B compra carta. Setas ou WASD navegam na interface. Enter confirma. Teclas 1, 2 e 3 usam consumíveis nos três espaços durante o seu turno." />
                            </ui:VisualElement>

                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- Rodapé específico do fluxo "revisão de teoria" (abertura automática ao entrar no duelo).
                     Fica oculto por omissão; MapWikiAccess.OpenForRevision(...) torna-o visível e preenche
                     o rótulo do checkbox com o tipo atual. -->
                <ui:VisualElement name="WikiRevisionFooter" class="wiki-revision-footer" style="display: none;">
                    <ui:Toggle name="WikiRevisionDontShowAgain" class="wiki-revision-toggle"
                               label="Não mostrar novamente para este tipo" />
                    <ui:Button name="WikiRevisionProceedBtn" text="Prosseguir" class="wiki-revision-proceed-btn" />
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
